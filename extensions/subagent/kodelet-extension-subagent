_stores: dict[Path, AgentStore] = {}
_live_runs: dict[tuple[Path, str], LiveRun] = {}
_reservation_completions: set[asyncio.Future[None]] = set()
_widget_locks: dict[tuple[Path, str], asyncio.Lock] = {}
_shutting_down = False


def is_agent_child(ctx: ToolContext | EventContext) -> bool:
    if os.environ.get(RECURSION_GUARD_ENV) == "1":
        return True
    invoked_by = (getattr(ctx, "invoked_by", None) or "").strip()
    return bool(invoked_by and invoked_by != "main")


@ext.on("agent.init")
async def disable_recursive_agents(
    _event: AgentInitEvent,
    ctx: EventContext,
) -> EventResult | None:
    if is_agent_child(ctx):
        return {"tools": {"disable": list(AGENT_TOOL_NAMES)}}
    return None


@ext.on("session.start")
@ext.on("agent.start")
async def restore_agent_widget(
    _event: SessionStartEvent | AgentStartEvent,
    ctx: EventContext,
) -> None:
    if is_agent_child(ctx):
        return
    owner_id = (ctx.conversation_id or "").strip()
    if not owner_id:
        return
    try:
        store = await store_for_context(ctx)
        await sync_agent_widget(ctx.ui, store, owner_id)
    except Exception as exc:  # noqa: BLE001
        ctx.log.warn(f"failed to restore background-agent widget: {exc}")  # noqa: G010


@ext.on("session.end")
async def interrupt_live_agents(
    _event: SessionEndEvent,
    _ctx: EventContext,
) -> None:
    global _shutting_down
    _shutting_down = True
    live_runs = [
        live
        for live in list(_live_runs.values())
        if live.store.runtime_id == RUNTIME_ID
    ]
    tasks = [
        live.runner_task
        for live in live_runs
        if live.runner_task is not None and not live.runner_task.done()
    ]
    for task in tasks:
        task.cancel()
    if tasks:
        await asyncio.gather(*tasks, return_exceptions=True)
    reservations = list(_reservation_completions)
    if reservations:
        await asyncio.gather(*reservations, return_exceptions=True)
    for store in list(_stores.values()):
        if store.runtime_id == RUNTIME_ID:
            with contextlib.suppress(Exception):
                await store.interrupt_runtime(
                    "agent interrupted because the extension session stopped"
                )


def resolve_agent_cwd(raw_cwd: str | None, workspace_cwd: str) -> Path:
    if raw_cwd is None:
        return Path(workspace_cwd).resolve()
    if not raw_cwd.strip():
        raise ValueError("cwd must be a non-empty string when provided")
    candidate = Path(raw_cwd).expanduser()
    if not candidate.is_absolute():
        candidate = Path(workspace_cwd) / candidate
    resolved = candidate.resolve()
    if not resolved.exists():
        raise ValueError(f"cwd does not exist: {resolved}")
    if not resolved.is_dir():
        raise ValueError(f"cwd is not a directory: {resolved}")
    return resolved


async def fork_parent_context(parent_context: ToolContext, name: str) -> str:
    try:
        return await parent_context.fork_conversation(name=name)
    except ConversationForkUnavailableError as exc:
        raise RuntimeError(
            "context_mode='fork' requires live conversation forking; use "
            "context_mode='fresh' to start without parent conversation memory"
        ) from exc


def owner_conversation_id(ctx: ToolContext) -> str:
    conversation_id = (ctx.conversation_id or "").strip()
    if not conversation_id:
        raise ValueError("async agents require an active conversation ID")
    return conversation_id


def database_path(ctx: ToolContext | EventContext) -> Path:
    return Path(ctx.storage.data_dir).resolve() / DATABASE_FILENAME


async def store_for_context(ctx: ToolContext | EventContext) -> AgentStore:
    path = database_path(ctx)
    store = _stores.get(path)
    if store is None:
        store = AgentStore(path, RUNTIME_ID)
        _stores[path] = store
    await store.initialize()
    return store


def live_run_key(store: AgentStore, agent_id: str) -> tuple[Path, str]:
    return store.path, agent_id


def child_tool_error() -> ToolExecutionResult:
    message = "async agent tools are only available to the main agent"
    return {"content": message, "error": message}


def tool_error(message: str) -> ToolExecutionResult:
    return {"content": message, "error": message}


def agent_not_found(agent_id: str) -> ToolExecutionResult:
    return tool_error(f"agent not found: {agent_id.strip()}")


def timestamp(value: float | None) -> str | None:
    if value is None:
        return None
    return datetime.fromtimestamp(value, UTC).isoformat().replace("+00:00", "Z")


def public_snapshot(
    agent: AgentRecord,
    *,
    include_result: bool = False,
) -> dict[str, object]:
    snapshot: dict[str, object] = {
        "agent_id": agent.id,
        "name": agent.name,
        "run_id": agent.run.id,
        "generation": agent.run.generation,
        "conversation_id": agent.conversation_id,
        "status": agent.run.status,
        "agent_status": agent.status,
        "task": agent.run.task,
        "cwd": agent.cwd,
        "context_mode": agent.context_mode,
        "created_at": timestamp(agent.run.created_at),
        "started_at": timestamp(agent.run.started_at),
        "completed_at": timestamp(agent.run.completed_at),
        "updated_at": timestamp(agent.run.updated_at),
    }
    if agent.run.error:
        snapshot["error"] = agent.run.error
    if include_result and agent.run.result is not None:
        snapshot["result"] = agent.run.result
    return snapshot


def agent_widget_line(agent: AgentRecord) -> UIFrameLine:
    icon_by_status = {
        "starting": "◌",
        "running": "●",
        "completed": "✓",
        "failed": "!",
        "interrupted": "!",
        "canceled": "×",
    }
    name = agent.name
    if len(name) > 88:
        name = f"{name[:85]}..."
    status = agent.run.status
    icon_style = {"bold": True} if status in ACTIVE_RUN_STATUSES else {"dim": True}
    status_style = (
        {"bold": True} if status in {"failed", "interrupted"} else {"dim": True}
    )
    spans: list[UIStyledSpan] = [
        {"text": f"{icon_by_status[status]} ", "style": icon_style},
        {"text": name},
        {"text": f"  {status}", "style": status_style},
        {"text": f"  {agent.id[-8:]}", "style": {"dim": True}},
    ]
    return {"spans": spans}


def agent_widget_lines(agents: list[AgentRecord]) -> list[UIFrameLine]:
    active = sum(agent.run.status in ACTIVE_RUN_STATUSES for agent in agents)
    completed = sum(agent.run.status == "completed" for agent in agents)
    attention = sum(agent.run.status in {"failed", "interrupted"} for agent in agents)
    canceled = sum(agent.run.status == "canceled" for agent in agents)
    summary_parts = [f"{active} active", f"{completed} completed"]
    if attention:
        summary_parts.append(f"{attention} need attention")
    if canceled:
        summary_parts.append(f"{canceled} canceled")
    header: list[UIStyledSpan] = [
        {"text": "Background agents", "style": {"bold": True}},
        {"text": f"  {' · '.join(summary_parts)}", "style": {"dim": True}},
    ]
    lines: list[UIFrameLine] = [{"spans": header}]
    lines.extend(agent_widget_line(agent) for agent in agents[:WIDGET_AGENT_LIMIT])
    if len(agents) > WIDGET_AGENT_LIMIT:
        lines.append(
            {
                "spans": [
                    {
                        "text": f"… and {len(agents) - WIDGET_AGENT_LIMIT} more",
                        "style": {"dim": True},
                    }
                ]
            }
        )
    return lines


def agent_widget_lock(store: AgentStore, owner_id: str) -> asyncio.Lock:
    return _widget_locks.setdefault((store.path, owner_id), asyncio.Lock())


async def sync_agent_widget(ui: Any, store: AgentStore, owner_id: str) -> None:
    if ui is None:
        return
    async with agent_widget_lock(store, owner_id):
        agents = await store.list(owner_id)
        if not agents:
            await ui.set_widget(WIDGET_ID, None)
            return
        await ui.set_widget(
            WIDGET_ID,
            agent_widget_lines(agents),
            {"placement": "aboveComposer"},
        )


async def safe_sync_agent_widget(ui: Any, store: AgentStore, owner_id: str) -> None:
    with contextlib.suppress(Exception):
        await sync_agent_widget(ui, store, owner_id)


def live_run_from_claim(claim: Claim, task: str, store: AgentStore) -> LiveRun:
    return LiveRun(
        store=store,
        agent_id=claim.agent.id,
        owner_conversation_id=claim.agent.owner_conversation_id,
        run_id=claim.lease.run_id,
        generation=claim.lease.generation,
        task=task,
        cwd=Path(claim.agent.cwd),
        context_mode=claim.agent.context_mode,
        lease=claim.lease,
        conversation_id=claim.agent.conversation_id,
    )


def ensure_runtime_accepting_agents() -> None:
    if _shutting_down:
        raise RuntimeError("the extension session is shutting down")


async def abandon_unlaunched_claim(
    claim: Claim,
    task: str,
    store: AgentStore,
    *,
    initial: bool,
) -> None:
    live = live_run_from_claim(claim, task, store)
    live.terminalizing = True
    heartbeat_task = start_agent_heartbeat(live)
    try:
        if initial and live.conversation_id is None:
            committed = await safe_worker_abort(live)
        else:
            committed = await safe_worker_terminal(
                live,
                "interrupted",
                error="agent setup stopped before the worker started",
            )
        if not committed:
            raise RuntimeError("failed to persist unlaunched agent cleanup")
    finally:
        await stop_task(heartbeat_task)


async def reserve_claim(
    operation: Awaitable[Claim],
    task: str,
    store: AgentStore,
    *,
    initial: bool,
) -> Claim:
    ensure_runtime_accepting_agents()
    completion = asyncio.get_running_loop().create_future()
    _reservation_completions.add(completion)
    reservation = asyncio.ensure_future(operation)
    try:
        try:
            claim = await asyncio.shield(reservation)
        except asyncio.CancelledError:
            claim = await reservation
            await abandon_unlaunched_claim(
                claim,
                task,
                store,
                initial=initial,
            )
            raise
        if _shutting_down:
            await abandon_unlaunched_claim(
                claim,
                task,
                store,
                initial=initial,
            )
            raise RuntimeError("the extension session is shutting down")
        return claim
    finally:
        if not completion.done():
            completion.set_result(None)
        _reservation_completions.discard(completion)


def is_definitive_worker_error(exc: Exception) -> bool:
    return isinstance(
        exc,
        (AgentNotFoundError, AgentConflictError, LeaseLostError),
    )


async def safe_worker_terminal(
    live: LiveRun,
    status: WorkerTerminalStatus,
    *,
    result: str | None = None,
    error: str | None = None,
) -> bool:
    retry_delay = min(
        WORKER_UPDATE_RETRY_INITIAL_SECONDS,
        WORKER_UPDATE_RETRY_MAX_SECONDS,
    )
    while True:
        try:
            await live.store.terminal(
                live.lease,
                status,
                conversation_id=live.conversation_id,
                result=result,
                error=error,
            )
            await safe_sync_agent_widget(
                live.ui,
                live.store,
                live.owner_conversation_id,
            )
            return True
        except Exception as exc:  # noqa: BLE001
            if is_definitive_worker_error(exc):
                return False
            remaining = live.lease.expires_at - live.store.current_time()
            if remaining <= 0:
                return False
            await asyncio.sleep(min(retry_delay, remaining))
            retry_delay = min(WORKER_UPDATE_RETRY_MAX_SECONDS, retry_delay * 2)


async def safe_worker_abort(live: LiveRun) -> bool:
    retry_delay = min(
        WORKER_UPDATE_RETRY_INITIAL_SECONDS,
        WORKER_UPDATE_RETRY_MAX_SECONDS,
    )
    while True:
        try:
            await live.store.abort(live.lease)
            await safe_sync_agent_widget(
                live.ui,
                live.store,
                live.owner_conversation_id,
            )
            return True
        except Exception as exc:  # noqa: BLE001
            if is_definitive_worker_error(exc):
                return False
            remaining = live.lease.expires_at - live.store.current_time()
            if remaining <= 0:
                return False
            await asyncio.sleep(min(retry_delay, remaining))
            retry_delay = min(WORKER_UPDATE_RETRY_MAX_SECONDS, retry_delay * 2)


async def heartbeat_agent(live: LiveRun) -> None:
    interval = max(MIN_HEARTBEAT_INTERVAL_SECONDS, HEARTBEAT_INTERVAL_SECONDS)
    while True:
        await asyncio.sleep(interval)
        while True:
            try:
                await live.store.heartbeat(live.lease)
                interval = max(
                    MIN_HEARTBEAT_INTERVAL_SECONDS,
                    HEARTBEAT_INTERVAL_SECONDS,
                )
                break
            except asyncio.CancelledError:
                raise
            except Exception as exc:  # noqa: BLE001
                if is_definitive_worker_error(exc):
                    if live.terminalizing:
                        return
                    live.heartbeat_error = f"agent lease was lost: {exc}"
                    if live.runner_task is not None:
                        live.runner_task.cancel()
                    return
                remaining = live.lease.expires_at - live.store.current_time()
                if remaining <= 0:
                    live.heartbeat_error = (
                        f"agent lease heartbeat expired after error: {exc}"
                    )
                    if live.runner_task is not None:
                        live.runner_task.cancel()
                    return
                await asyncio.sleep(
                    min(
                        HEARTBEAT_RETRY_MAX_SECONDS,
                        max(MIN_HEARTBEAT_INTERVAL_SECONDS, remaining / 2),
                    )
                )


def start_agent_heartbeat(live: LiveRun) -> asyncio.Task[None]:
    return asyncio.create_task(
        heartbeat_agent(live),
        name=f"kodelet-{live.agent_id}-heartbeat",
    )


async def stop_task(task: asyncio.Task[None] | None) -> None:
    if task is None:
        return
    task.cancel()
    await asyncio.gather(task, return_exceptions=True)


async def steering_pump(live: LiveRun, session: SteeringSession) -> None:
    while True:
        try:
            queued = await live.store.next_steering(live.lease)
        except asyncio.CancelledError:
            raise
        except Exception as exc:  # noqa: BLE001
            if is_definitive_worker_error(exc):
                live.heartbeat_error = f"agent steering lease was lost: {exc}"
                if live.runner_task is not None:
                    live.runner_task.cancel()
                return
            await asyncio.sleep(STEERING_RETRY_SECONDS)
            continue
        if queued is None:
            await asyncio.sleep(STEERING_POLL_SECONDS)
            continue
        try:
            result = await session.steer(queued.message)
        except asyncio.CancelledError:
            raise
        except Exception:  # noqa: BLE001
            await asyncio.sleep(STEERING_RETRY_SECONDS)
            continue
        if result.get("outcome") in {"injected", "startedNewTurn"}:
            while True:
                try:
                    await live.store.acknowledge_steering(live.lease, queued.id)
                    break
                except asyncio.CancelledError:
                    raise
                except Exception as exc:  # noqa: BLE001
                    if is_definitive_worker_error(exc):
                        return
                    await asyncio.sleep(STEERING_RETRY_SECONDS)
        else:
            await asyncio.sleep(STEERING_RETRY_SECONDS)


async def run_agent_job(
    live: LiveRun,
    heartbeat_task: asyncio.Task[None] | None = None,
) -> None:
    client: Client | None = None
    steering_task: asyncio.Task[None] | None = None
    if heartbeat_task is None:
        heartbeat_task = start_agent_heartbeat(live)
    heartbeat_stopped = False

    async def stop_heartbeat() -> None:
        nonlocal heartbeat_stopped
        if heartbeat_stopped:
            return
        heartbeat_stopped = True
        await stop_task(heartbeat_task)

    phase = "starting"
    try:
        if live.heartbeat_error is not None:
            raise RuntimeError(live.heartbeat_error)
        client = Client(
            command="kodelet",
            cwd=str(live.cwd),
            env={RECURSION_GUARD_ENV: "1"},
        )
        live.client = client
        conversation_id = live.conversation_id
        was_unattached = conversation_id is None
        if conversation_id is not None:
            raw_session = await asyncio.wait_for(
                client.create_session(
                    resume=conversation_id,
                    cwd=str(live.cwd),
                    streaming=True,
                ),
                timeout=AGENT_START_TIMEOUT_SECONDS,
            )
        else:
            raw_session = await asyncio.wait_for(
                client.create_session(
                    cwd=str(live.cwd),
                    streaming=True,
                ),
                timeout=AGENT_START_TIMEOUT_SECONDS,
            )
        session = cast(SteeringSession, raw_session)
        live.session = session
        live.conversation_id = session.id

        if was_unattached:
            await live.store.attach_conversation(
                live.lease,
                live.conversation_id,
            )

        await live.store.mark_running(live.lease, live.conversation_id)
        await safe_sync_agent_widget(
            live.ui,
            live.store,
            live.owner_conversation_id,
        )
        phase = "running"
        steering_task = asyncio.create_task(
            steering_pump(live, session),
            name=f"kodelet-{live.agent_id}-steering",
        )

        response = await asyncio.wait_for(
            session.run_and_wait(live.task),
            timeout=AGENT_TIMEOUT_SECONDS,
        )
        content = response.get("content")
        result = content.strip() if isinstance(content, str) else ""
        await stop_task(steering_task)
        steering_task = None
        live.terminalizing = True
        if not result:
            await safe_worker_terminal(
                live,
                "failed",
                error="agent returned an empty response",
            )
        else:
            await safe_worker_terminal(live, "idle", result=result)
        await stop_heartbeat()
    except asyncio.CancelledError:
        await stop_task(steering_task)
        if not live.parent_canceled:
            live.terminalizing = True
            await safe_worker_terminal(
                live,
                "interrupted",
                error=live.heartbeat_error
                or "agent interrupted because the extension session stopped",
            )
        await stop_heartbeat()
        raise
    except TimeoutError:
        await stop_task(steering_task)
        live.terminalizing = True
        await safe_worker_terminal(
            live,
            "failed",
            error=(
                "agent timed out while starting the kodelet session"
                if phase == "starting"
                else "agent timed out while waiting for kodelet to finish"
            ),
        )
        await stop_heartbeat()
    except OSError as exc:
        await stop_task(steering_task)
        live.terminalizing = True
        await safe_worker_terminal(
            live,
            "failed",
            error=f"Failed to execute kodelet: {exc}",
        )
        await stop_heartbeat()
    except Exception as exc:  # noqa: BLE001
        await stop_task(steering_task)
        live.terminalizing = True
        await safe_worker_terminal(
            live,
            "failed",
            error=f"agent failed: {exc}",
        )
        await stop_heartbeat()
    finally:
        await stop_task(steering_task)
        await stop_heartbeat()
        if client is not None:
            with contextlib.suppress(Exception):
                await client.close()
        live.client = None
        live.session = None
        key = live_run_key(live.store, live.agent_id)
        if _live_runs.get(key) is live:
            _live_runs.pop(key, None)
        await close_background_lease(live)


async def close_background_lease(live: LiveRun) -> None:
    lease = live.background_lease
    if lease is None:
        return
    retry_delay = BACKGROUND_LEASE_RELEASE_RETRY_INITIAL_SECONDS
    while True:
        try:
            await lease.close()
        except asyncio.CancelledError:
            if _shutting_down:
                return
            raise
        except Exception:  # noqa: BLE001
            if _shutting_down:
                return
            await asyncio.sleep(retry_delay)
            retry_delay = min(
                BACKGROUND_LEASE_RELEASE_RETRY_MAX_SECONDS,
                retry_delay * 2,
            )
            continue
        live.background_lease = None
        return


def launch_live_run(
    live: LiveRun,
    heartbeat_task: asyncio.Task[None] | None = None,
) -> None:
    runner_task = asyncio.create_task(
        run_agent_job(live, heartbeat_task),
        name=f"kodelet-{live.agent_id}-{live.generation}",
    )
    live.runner_task = runner_task
    key = live_run_key(live.store, live.agent_id)
    _live_runs[key] = live
    runner_task.add_done_callback(
        lambda _task, completed_live=live, completed_key=key: (
            _live_runs.pop(completed_key, None)
            if _live_runs.get(completed_key) is completed_live
            else None
        )
    )


async def prepare_claim(
    claim: Claim,
    task: str,
    store: AgentStore,
    ctx: ToolContext,
    *,
    initial: bool,
) -> tuple[Claim, LiveRun]:
    ensure_runtime_accepting_agents()
    live = live_run_from_claim(claim, task, store)
    live.ui = getattr(ctx, "ui", None)
    setup_heartbeat = start_agent_heartbeat(live)
    try:
        live.background_lease = await ctx.acquire_background_task(
            f"subagent {claim.agent.name} ({live.agent_id}): "
            f"{' '.join(task.split())[:160]}"
        )
        if live.conversation_id is None and live.context_mode == "fork":
            live.conversation_id = await fork_parent_context(ctx, claim.agent.name)
            if live.heartbeat_error is not None:
                raise RuntimeError(live.heartbeat_error)
            attached = await store.attach_conversation(
                live.lease,
                live.conversation_id,
            )
            claim = Claim(agent=attached, lease=claim.lease)
        ensure_runtime_accepting_agents()
        launch_live_run(live, setup_heartbeat)
        setup_heartbeat = None
        return claim, live
    except asyncio.CancelledError:
        live.terminalizing = True
        try:
            if initial and live.conversation_id is None:
                await safe_worker_abort(live)
            else:
                await safe_worker_terminal(
                    live,
                    "interrupted",
                    error="agent setup was canceled before the worker started",
                )
        finally:
            await stop_task(setup_heartbeat)
            await close_background_lease(live)
        raise
    except Exception:
        live.terminalizing = True
        try:
            if initial and live.conversation_id is None:
                await safe_worker_abort(live)
            else:
                await safe_worker_terminal(
                    live,
                    "failed",
                    error="agent setup failed before the worker started",
                )
        finally:
            await stop_task(setup_heartbeat)
            await close_background_lease(live)
        raise


async def spawn_agent(
    input: SpawnAgentInput,
    ctx: ToolContext,
) -> ToolExecutionResult:
    if is_agent_child(ctx):
        return child_tool_error()
    try:
        name = validate_agent_name(input.name)
    except ValueError as exc:
        return tool_error(str(exc))
    task = input.task.strip()
    if not task:
        return tool_error("task is required and must be a non-empty string")
    try:
        owner_id = owner_conversation_id(ctx)
        agent_cwd = resolve_agent_cwd(input.cwd, ctx.cwd)
        store = await store_for_context(ctx)
        claim = await reserve_claim(
            store.create(
                owner_id,
                name,
                task,
                str(agent_cwd),
                input.context_mode,
            ),
            task,
            store,
            initial=True,
        )
        claim, live = await prepare_claim(
            claim,
            task,
            store,
            ctx,
            initial=True,
        )
        await safe_sync_agent_widget(ctx.ui, store, owner_id)
    except Exception as exc:  # noqa: BLE001
        return tool_error(f"spawn_agent failed: {exc}")

    conversation_detail = (
        f" in conversation {live.conversation_id}"
        if live.conversation_id is not None
        else " with fresh context"
    )
    return {
        "content": (
            f"Spawned agent {claim.agent.name!r} ({live.agent_id})"
            f"{conversation_detail}. Continue with independent work and call "
            "wait_agent before relying on its result."
        ),
        "data": public_snapshot(claim.agent),
    }


async def wait_agent(
    input: WaitAgentInput,
    ctx: ToolContext,
) -> ToolExecutionResult:
    if is_agent_child(ctx):
        return child_tool_error()
    agent_id = input.agent_id.strip()
    try:
        owner_id = owner_conversation_id(ctx)
        store = await store_for_context(ctx)
        agent = await store.get(owner_id, agent_id)
    except AgentNotFoundError:
        return agent_not_found(agent_id)
    except Exception as exc:  # noqa: BLE001
        return tool_error(f"wait_agent failed: {exc}")

    selected_run_id = agent.run.id
    progress: TaskProgress | None = None
    if agent.run.status in ACTIVE_RUN_STATUSES and input.timeout_ms > 0:
        progress = TaskProgress(
            ctx,
            kind="subagent",
            task=agent.run.task,
            cwd=agent.cwd,
            running_title="Waiting for background agent",
            completed_title="Finished waiting for background agent",
            failed_title="Background agent failed",
            responding_detail="agent is responding",
        )
        await progress.start()
        loop = asyncio.get_running_loop()
        deadline = loop.time() + input.timeout_ms / 1000
        attached = False
        try:
            while agent.run.status in ACTIVE_RUN_STATUSES:
                if not attached:
                    live = _live_runs.get(live_run_key(store, agent_id))
                    if (
                        live is not None
                        and live.run_id == selected_run_id
                        and live.session is not None
                    ):
                        progress.attach(live.session)
                        attached = True
                remaining = deadline - loop.time()
                if remaining <= 0:
                    break
                await asyncio.sleep(min(WAIT_POLL_SECONDS, remaining))
                try:
                    agent = await store.get(owner_id, agent_id, selected_run_id)
                except AgentNotFoundError:
                    await progress.finish(
                        success=False,
                        error=f"agent not found: {agent_id}",
                    )
                    return agent_not_found(agent_id)
                except Exception as exc:  # noqa: BLE001
                    message = f"wait_agent failed: {exc}"
                    await progress.finish(success=False, error=message)
                    return tool_error(message)
        except asyncio.CancelledError:
            with contextlib.suppress(Exception):
                await progress.finish(success=False, error="wait canceled")
            raise

    await safe_sync_agent_widget(ctx.ui, store, owner_id)

    snapshot = public_snapshot(
        agent,
        include_result=agent.run.status == "completed",
    )
    if progress is not None:
        if agent.run.status in ACTIVE_RUN_STATUSES:
            await progress.flush()
            task_run = progress.snapshot()
            await progress.finish(success=True)
        else:
            progress_success = agent.run.status == "completed"
            progress_error = None
            if not progress_success:
                progress_error = agent.run.error or f"agent {agent.run.status}"
            task_run = await progress.finish(
                success=progress_success,
                error=progress_error,
            )
        snapshot["taskRun"] = task_run
    if agent.run.status in ACTIVE_RUN_STATUSES:
        return {
            "content": f"Agent {agent_id} is still {agent.run.status}.",
            "data": snapshot,
        }
    if agent.run.status == "completed":
        return {"content": agent.run.result or "", "data": snapshot}
    if agent.run.status == "failed":
        message = f"Agent {agent_id} failed: {agent.run.error or 'unknown error'}"
        return {"content": message, "error": message, "data": snapshot}
    if agent.run.status == "interrupted":
        message = (
            f"Agent {agent_id} was interrupted: "
            f"{agent.run.error or 'worker stopped'}. Use followup_agent to resume it."
        )
        return {"content": message, "error": message, "data": snapshot}
    return {
        "content": f"Agent {agent_id} was canceled.",
        "data": snapshot,
    }


async def list_agents(
    _input: ListAgentsInput,
    ctx: ToolContext,
) -> ToolExecutionResult:
    if is_agent_child(ctx):
        return child_tool_error()
    try:
        owner_id = owner_conversation_id(ctx)
        store = await store_for_context(ctx)
        agents = await store.list(owner_id)
        await safe_sync_agent_widget(ctx.ui, store, owner_id)
    except Exception as exc:  # noqa: BLE001
        return tool_error(f"list_agents failed: {exc}")
    if not agents:
        return {
            "content": "No background agents have been spawned by this conversation.",
            "data": {"agents": []},
        }
    lines = [
        "Background agents:",
        "Name\tAgent ID\tConversation ID\tAgent state\tRun state\tTask",
    ]
    for agent in agents:
        task = " ".join(agent.run.task.split())
        if len(task) > 100:
            task = f"{task[:97]}..."
        conversation_id = agent.conversation_id or "pending"
        lines.append(
            f"{agent.name}\t{agent.id}\t{conversation_id}\t{agent.status}\t"
            f"{agent.run.status}\t{task}"
        )
    return {
        "content": "\n".join(lines),
        "data": {"agents": [public_snapshot(agent) for agent in agents]},
    }


async def followup_agent(
    input: FollowupAgentInput,
    ctx: ToolContext,
) -> ToolExecutionResult:
    if is_agent_child(ctx):
        return child_tool_error()
    agent_id = input.agent_id.strip()
    task = input.task.strip()
    if not task:
        return tool_error("task is required and must be a non-empty string")
    try:
        owner_id = owner_conversation_id(ctx)
        store = await store_for_context(ctx)
        claim = await reserve_claim(
            store.claim(owner_id, agent_id, task),
            task,
            store,
            initial=False,
        )
        claim, live = await prepare_claim(
            claim,
            task,
            store,
            ctx,
            initial=False,
        )
        await safe_sync_agent_widget(ctx.ui, store, owner_id)
    except AgentNotFoundError:
        return agent_not_found(agent_id)
    except Exception as exc:  # noqa: BLE001
        return tool_error(f"followup_agent failed: {exc}")
    return {
        "content": (
            f"Started follow-up run {live.run_id} for agent "
            f"{claim.agent.name!r} ({live.agent_id})"
            + (
                f" in conversation {live.conversation_id}."
                if live.conversation_id is not None
                else " with fresh context."
            )
            + " Call wait_agent before relying on its result."
        ),
        "data": public_snapshot(claim.agent),
    }


async def steer_agent(
    input: SteerAgentInput,
    ctx: ToolContext,
) -> ToolExecutionResult:
    if is_agent_child(ctx):
        return child_tool_error()
    agent_id = input.agent_id.strip()
    try:
        owner_id = owner_conversation_id(ctx)
        store = await store_for_context(ctx)
        result = await store.enqueue_steering(
            owner_id,
            agent_id,
            input.message,
        )
    except AgentNotFoundError:
        return agent_not_found(agent_id)
    except Exception as exc:  # noqa: BLE001
        return tool_error(f"steer_agent failed: {exc}")
    queued = " behind pending steering" if result["alreadyPending"] else ""
    return {
        "content": f"Queued steering for agent {agent_id}{queued}.",
        "data": {"agent_id": agent_id, **result},
    }


async def cancel_agent(
    input: CancelAgentInput,
    ctx: ToolContext,
) -> ToolExecutionResult:
    if is_agent_child(ctx):
        return child_tool_error()
    agent_id = input.agent_id.strip()
    try:
        owner_id = owner_conversation_id(ctx)
        store = await store_for_context(ctx)
        agent = await store.cancel(owner_id, agent_id)
        await safe_sync_agent_widget(ctx.ui, store, owner_id)
    except AgentNotFoundError:
        return agent_not_found(agent_id)
    except Exception as exc:  # noqa: BLE001
        return tool_error(f"cancel_agent failed: {exc}")

    live = _live_runs.get(live_run_key(store, agent_id))
    if live is not None:
        live.parent_canceled = True
    if (
        live is not None
        and live.runner_task is not None
        and not live.runner_task.done()
    ):
        live.runner_task.cancel()
        cleanup = asyncio.gather(live.runner_task, return_exceptions=True)
        try:
            await asyncio.wait_for(
                asyncio.shield(cleanup),
                timeout=CANCEL_CLEANUP_TIMEOUT_SECONDS,
            )
        except TimeoutError:
            return {
                "content": (
                    f"Cancellation persisted for agent {agent_id}; "
                    "local cleanup is still finishing."
                ),
                "data": public_snapshot(agent),
            }
    return {
        "content": f"Canceled agent {agent_id}.",
        "data": public_snapshot(agent),
    }


