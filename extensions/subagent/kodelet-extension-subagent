#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["kodelet-sdk>=0.1.16"]
# ///

from __future__ import annotations

import asyncio
import os
import textwrap
from pathlib import Path

from kodelet_sdk import (
    BaseModel,
    Client,
    ConversationForkUnavailableError,
    Extension,
    Field,
    TaskProgress,
    ToolContext,
    ToolExecutionResult,
)

DESCRIPTION = textwrap.dedent(
    """
    Delegate a task to an independent Kodelet agent. When available, the subagent
    inherits the caller's live conversation context in an isolated fork; otherwise
    it starts with a fresh context. Use this for complex implementation,
    investigation, review, or troubleshooting work that benefits from its own tool
    loop. Include task-specific constraints, the desired outcome, and the expected
    response format.
    """
).strip()

TOOL_TIMEOUT_SECONDS = 60 * 60
AGENT_TIMEOUT_SECONDS = TOOL_TIMEOUT_SECONDS - 10
RECURSION_GUARD_ENV = "KODELET_SUBAGENT_EXTENSION_CHILD"

ext = Extension(name="subagent", version="0.1.0")


class SubagentInput(BaseModel):
    task: str = Field(
        min_length=1,
        description=(
            "A complete, self-contained task for the subagent. Include the relevant "
            "context, constraints, desired outcome, and expected response format."
        ),
    )
    cwd: str | None = Field(
        default=None,
        description=(
            "Optional directory for the subagent. Defaults to the current workspace "
            "directory. Relative paths are resolved against the current workspace."
        ),
    )


def resolve_subagent_cwd(raw_cwd: str | None, workspace_cwd: str) -> Path:
    if raw_cwd is None:
        return Path(workspace_cwd).resolve()
    if not raw_cwd.strip():
        raise ValueError("cwd must be a non-empty string when provided")

    candidate = Path(raw_cwd).expanduser()
    if not candidate.is_absolute():
        candidate = Path(workspace_cwd) / candidate

    resolved = candidate.resolve()
    if not resolved.exists():
        raise ValueError(f"cwd does not exist: {resolved}")
    if not resolved.is_dir():
        raise ValueError(f"cwd is not a directory: {resolved}")
    return resolved


def build_subagent_progress(
    ctx: ToolContext,
    task: str,
    agent_cwd: Path,
    context_mode: str | None = None,
) -> TaskProgress:
    context_suffix = f" · {context_mode} context" if context_mode else ""
    return TaskProgress(
        ctx,
        kind="subagent",
        task=task,
        cwd=str(agent_cwd),
        running_title=f"Delegated task{context_suffix}",
        completed_title=f"Delegated task{context_suffix}",
        failed_title=f"Delegated task failed{context_suffix}",
        responding_detail="writing response",
    )


async def inherit_parent_context(parent_context: ToolContext) -> str | None:
    try:
        return await parent_context.fork_conversation()
    except ConversationForkUnavailableError as exc:
        parent_context.log.warn(  # noqa: G010, PLE1205
            "subagent falling back to fresh context",
            {
                "contextMode": "fresh",
                "parentConversationId": parent_context.conversation_id,
                "reason": str(exc),
            },
        )
        return None


async def run_subagent(
    task: str,
    agent_cwd: Path,
    inherited_conversation_id: str | None,
    progress: TaskProgress,
) -> str:
    client = Client(
        command="kodelet",
        cwd=str(agent_cwd),
        env={RECURSION_GUARD_ENV: "1"},
    )
    try:

        async def run_once() -> object:
            if inherited_conversation_id is not None:
                session = await client.create_session(
                    resume=inherited_conversation_id,
                    cwd=str(agent_cwd),
                    streaming=True,
                )
            else:
                session = await client.create_session(
                    cwd=str(agent_cwd),
                    streaming=True,
                )
            progress.attach(session)
            return await session.run_and_wait(task)

        response = await asyncio.wait_for(run_once(), timeout=AGENT_TIMEOUT_SECONDS)
    except TimeoutError:
        raise TimeoutError(
            "subagent timed out while waiting for kodelet to finish"
        ) from None
    finally:
        await client.close()

    content = response.get("content")
    return content if isinstance(content, str) else ""


async def subagent(input: SubagentInput, ctx: ToolContext) -> ToolExecutionResult:
    if os.environ.get(RECURSION_GUARD_ENV) == "1":
        message = "subagent recursion is disabled"
        return {"content": message, "error": message}

    task = input.task.strip()
    if not task:
        message = "task is required and must be a non-empty string"
        return {"content": message, "error": message}

    try:
        agent_cwd = resolve_subagent_cwd(input.cwd, ctx.cwd)
    except ValueError as exc:
        return {"content": str(exc), "error": str(exc)}

    try:
        inherited_conversation_id = await inherit_parent_context(ctx)
    except RuntimeError as exc:
        message = f"subagent failed: {exc}"
        progress = build_subagent_progress(ctx, task, agent_cwd)
        await progress.start()
        snapshot = await progress.finish(success=False, error=message)
        return {"content": message, "error": message, "data": {"taskRun": snapshot}}

    context_mode = "inherited" if inherited_conversation_id is not None else "fresh"
    progress = build_subagent_progress(ctx, task, agent_cwd, context_mode)
    await progress.start()

    try:
        stdout = await run_subagent(
            task,
            agent_cwd,
            inherited_conversation_id,
            progress,
        )
    except TimeoutError as exc:
        message = str(exc)
        snapshot = await progress.finish(success=False, error=message)
        return {"content": message, "error": message, "data": {"taskRun": snapshot}}
    except OSError as exc:
        message = f"Failed to execute kodelet: {exc}"
        snapshot = await progress.finish(success=False, error=message)
        return {"content": message, "error": message, "data": {"taskRun": snapshot}}
    except Exception as exc:  # noqa: BLE001
        message = f"subagent failed: {exc}"
        snapshot = await progress.finish(success=False, error=message)
        return {"content": message, "error": message, "data": {"taskRun": snapshot}}

    stdout = stdout.strip()
    if not stdout:
        message = "subagent returned an empty response"
        snapshot = await progress.finish(success=False, error=message)
        return {"content": message, "error": message, "data": {"taskRun": snapshot}}

    snapshot = await progress.finish(success=True)
    return {"content": stdout, "data": {"taskRun": snapshot}}


if os.environ.get(RECURSION_GUARD_ENV) != "1":
    ext.tool(
        "subagent",
        description=DESCRIPTION,
        input_schema=SubagentInput,
        timeout_in_sec=TOOL_TIMEOUT_SECONDS,
    )(subagent)


if __name__ == "__main__":
    ext.run_sync()
