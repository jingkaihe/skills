#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["kodelet-sdk>=0.7.0,<0.8"]
# ///

from kodelet_sdk import Extension

# Models follow `kodelet setup`; tool modes are pinned per provider (OpenAI
# patch, Anthropic full) rather than inherited from the runner.
# Both use subscriptions logged in on the daemon (`kodelet codex login`,
# `kodelet anthropic login`), not API keys.
REASONING_EFFORTS = ["medium", "high", "xhigh", "max"]

ext = Extension(name="profiles", version="0.1.0")
ext.register_profile(
    "openai",
    provider="openai",
    model="gpt-6-astra",
    max_tokens=128000,
    reasoning_effort="xhigh",
    allowed_reasoning_efforts=REASONING_EFFORTS,
    weak_model="gpt-5.6-luna",
    weak_model_max_tokens=8192,
    tool_mode="patch",
    openai={"api_mode": "responses", "platform": "codex"},
    hidden=False,
)
ext.register_profile(
    "anthropic",
    provider="anthropic",
    model="claude-opus-5-5",
    max_tokens=64000,
    reasoning_effort="xhigh",
    allowed_reasoning_efforts=REASONING_EFFORTS,
    weak_model="claude-haiku-5-5",
    weak_model_max_tokens=8192,
    tool_mode="full",
    anthropic_api_access="subscription",
    hidden=False,
)


if __name__ == "__main__":
    ext.run_sync()
